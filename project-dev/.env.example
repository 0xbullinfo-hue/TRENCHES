# ==============================================================================
# TrenchLabsHQ Environment Configuration
# Copy this file to .env.local for local development, or set in hosting provider.
# All sensitive credentials should be set in environment variables only.
# ==============================================================================

# ----------------- Required in Production -----------------
# Dedicated session HMAC secret (32+ random characters; e.g. `openssl rand -hex 32`).
# In production, sessions are disabled without this. Do NOT reuse any other secret.
SESSION_SECRET=

# Persistence (REQUIRED on serverless hosts: Vercel / Netlify / Cloudflare).
# Upstash Redis REST credentials. Server-only; never prefix with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to true only on a single persistent server (VPS/Docker with disk volume) to allow local db.json.
# ALLOW_FILE_PERSISTENCE=true

# Server-only Solana RPC. Use a KEYED provider (Helius / QuickNode) in production; the public endpoint rate-limits.
SOLANA_RPC=https://api.mainnet-beta.solana.com
# Browser RPC (visible to visitors; use a domain-restricted key in production)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Official $GENESIS SPL token mint
NEXT_PUBLIC_GENESIS_MINT=EM9M8RaxSjSf2UT2e2xndaBjjC1ijkT2nH5U3j6epump

# Canonical site URL (used in bot messages and deep links; without trailing slash)
SITE_URL=https://trenchlabshq.xyz
NEXT_PUBLIC_SITE_URL=https://trenchlabshq.xyz

# Master Admin Wallet (permanent Pro access, bypasses gates, posts/edits calls, exempt from sweep)
ADMIN_WALLET=FzFuSbWnTk7PR6fD84HHnE5w8qdwHjQr78HzfR817p3e

# ----------------- Telegram (Alerts + Dual Groups) -----------------
# 1) Create a bot via @BotFather -> token + username.
# 2) Webhook secret: long random string (letters, digits, _, - only).
# 3) Group IDs: numeric IDs (starting with -100) for Member and Pro groups.
# 4) The bot must be added as Administrator in both groups with "Ban Users" permission.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Trenchlabs_bot
TELEGRAM_WEBHOOK_SECRET=

# Numeric Telegram Group IDs (starts with -100...) used by the bot to kick/demote expired stakes or non-holders
TELEGRAM_MEMBER_GROUP_ID=
TELEGRAM_PRO_GROUP_ID=

# Telegram Group Invite Links (Set to your private group invite links; never hardcode or commit real links)
TELEGRAM_MEMBER_INVITE_URL=
TELEGRAM_PRO_INVITE_URL=

# Secret key protecting the scheduled cron endpoints (/api/telegram/monitor and /api/telegram/sweep).
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` automatically.
CRON_SECRET=

# Build-time flag: show the "Get new calls on Telegram" button on the dashboard
NEXT_PUBLIC_TELEGRAM_ALERTS=true

# ----------------- Staking & Market Data -----------------
# StakePoint Staking Configuration (Primary Staking Tool)
NEXT_PUBLIC_STAKEPOINT_URL=https://stakepoint.app
NEXT_PUBLIC_STAKEPOINT_PROGRAM_ID=
NEXT_PUBLIC_STAKEPOINT_POOL_ID=

# Staking requirements (Pro tier)
STAKE_MINIMUM_USD=250
STAKE_LOCK_DAYS=90

# ---- Market data providers (server-side only; never use NEXT_PUBLIC_ for these) ----
# CoinStats is OPTIONAL. It is used (first) only when COINSTATS_ENABLED=true AND an API key is set.
# Leave it disabled and the app runs on DexScreener alone. Never commit a real key.
# Note: the CoinStats free plan is 20,000 credits/month at 2 req/s; every lookup costs credits.
COINSTATS_ENABLED=false
COINSTATS_API_KEY=

# Independent fallback provider (no key needed). Set to false only to disable it.
DEXSCREENER_ENABLED=true

# Market-data configuration (invalid / non-positive values fall back to these defaults)
MARKET_DATA_TIMEOUT_MS=8000
MARKET_DATA_CACHE_TTL_SECONDS=30
MARKET_DATA_STALE_TTL_SECONDS=180
# Shared cache uses UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN (see above); without them it
# degrades to per-instance memory caching.

# Emergency maintenance mode (set to true to show maintenance screen to visitors)
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Content-Security-Policy enforcement (set to true after verifying staging)
# CSP_ENFORCE=true
