# TrenchLabsHQ Environment Configuration

# Solana Keyless Public RPC Endpoint for client ConnectionProvider (never place keyed RPC credentials here)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Server-Only Solana RPC Endpoint (supports private keyed RPC, e.g. Helius / QuickNode / Alchemy)
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Official $GENESIS SPL Token Mint
NEXT_PUBLIC_GENESIS_MINT=EM9M8RaxSjSf2UT2e2xndaBjjC1ijkT2nH5U3j6epump

# CoinStats API Key (Optional for live multi-chain portfolio and token market data)
# Get a key at https://coinstats.app/api
COINSTATS_API_KEY=

# Maintenance Mode Gate:
# Set to 'true' to display the emergency maintenance notice screen to all visitors
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Persistence for admin-posted calls (REQUIRED on serverless hosts: Vercel/Netlify/Cloudflare).
# Create a free Upstash Redis database and copy the REST credentials. Server-only; never prefix with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Single persistent server (VPS/Docker with a volume) only: allow local-disk persistence in production.
# ALLOW_FILE_PERSISTENCE=true

# Content-Security-Policy ships as Report-Only; set to 'true' to enforce after verifying wallets on staging.
# CSP_ENFORCE=true
